{
  "cljfmt tonsky config": {
    "prefix": "cljfmt-tonsky",
    "description": "Drop-in .cljfmt.edn using Tonsky's Better Clojure Formatting rules",
    "body": [
      "{:indents {#re \".*\" [[:inner 0]]}",
      " :remove-surrounding-whitespace?  false",
      " :remove-trailing-whitespace?     false",
      " :remove-consecutive-blank-lines? false}"
    ]
  }
}
